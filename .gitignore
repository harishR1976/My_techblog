# Dependencies
node_modules/
**/node_modules/

# Production Build outputs
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# Environment Variables & Credentials
.env
**/.env
.env.local
.env.*.local
*.env

# Operating System Files
.DS_Store
Thumbs.db

# User Uploads (keep directory via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories
.vscode/
.idea/

# Ignore all environment variants
.env.*
**/.env.*

# Allow example environment files
!.env.example
!**/.env.example
